<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Shiqi</AssemblyName>
    <RootNamespace>Shiqi.Desktop</RootNamespace>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets/Shiqi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shiqi.Core/Shiqi.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <AvaloniaResource Include="Assets/Shiqi.ico" />
    <AvaloniaResource Include="Assets/Shiqi.png" />
    <Content Include="Assets/Shiqi.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
